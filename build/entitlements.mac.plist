<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ONLY for unsigned/ad-hoc TEST builds (npm run desktop:mac).
  Ad-hoc signatures carry no Team ID, so library validation would refuse the native
  keychain module. Signed releases use entitlements.mac.release.plist instead, which
  keeps library validation switched on.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
