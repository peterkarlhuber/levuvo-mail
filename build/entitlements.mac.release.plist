<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Signed + notarized releases (npm run release:signed:mac). Hardened runtime with
  library validation ENABLED: only code signed with the same Developer ID Team may load.
  allow-jit is required by the V8 engine inside Electron.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
